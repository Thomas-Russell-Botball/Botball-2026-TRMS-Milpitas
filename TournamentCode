#include <kipr/wombat.h>
#include <stdlib.h>

#define LEFTMOTOR1 0
#define LEFTMOTOR2 1
#define RIGHTMOTOR1 2
#define RIGHTMOTOR2 3

#define LIGHTSENSOR1 0
#define LIGHTSENSOR2 1

void drive(int cm, int speed){
    float move = 2000*(cm/27.0);
    cmpc(RIGHTMOTOR1);
    cmpc(LEFTMOTOR1);
    
    while(abs(gmpc(RIGHTMOTOR1)) < move){
        mav(RIGHTMOTOR1, speed);
        mav(RIGHTMOTOR2, -speed);
        mav(LEFTMOTOR1, speed);
        mav(LEFTMOTOR2, -speed);
    }
    
    mav(RIGHTMOTOR1, 0);
    mav(RIGHTMOTOR2, 0);
    mav(LEFTMOTOR1, 0);
    mav(LEFTMOTOR2, 0);
    msleep(20);
}

void turnright(int distance, int speed){
    cmpc(LEFTMOTOR1);
    cmpc(RIGHTMOTOR1);
    
    while(fabs(gmpc(LEFTMOTOR1)) < distance){
        mav(RIGHTMOTOR1, -speed);
        mav(RIGHTMOTOR2, speed);
        mav(LEFTMOTOR1, speed);
        mav(LEFTMOTOR2, -speed);
    }
    
    mav(RIGHTMOTOR1, 0);
    mav(RIGHTMOTOR2, 0);
    mav(LEFTMOTOR1, 0);
    mav(LEFTMOTOR2, 0);
    msleep(20);
}

void turnleft(int distance, int speed){
    cmpc(RIGHTMOTOR1);
    cmpc(LEFTMOTOR1);
    
    while(fabs(gmpc(RIGHTMOTOR1)) < distance){
        mav(RIGHTMOTOR1, speed);
        mav(RIGHTMOTOR2, -speed);
        mav(LEFTMOTOR1, -speed);
        mav(LEFTMOTOR2, speed);
    }
    
    mav(RIGHTMOTOR1, 0);
    mav(RIGHTMOTOR2, 0);
    mav(LEFTMOTOR1, 0);
    mav(LEFTMOTOR2, 0);
    msleep(20);
}

void linefollow(int distance, int speed, int sensorPort, float compensation_rate){
    cmpc(RIGHTMOTOR1);
    cmpc(LEFTMOTOR1);
    
    while (abs(gmpc(RIGHTMOTOR1)) < distance) {
        int error = analog(sensorPort) - 3000;  // USE PASSED SENSOR PORT
        float speed_modifier = -1 * error * compensation_rate;
        
        mav(LEFTMOTOR1, speed - speed_modifier);
        mav(LEFTMOTOR2, -speed + speed_modifier);
        mav(RIGHTMOTOR1, speed + speed_modifier);
        mav(RIGHTMOTOR2, -speed - speed_modifier);
    }
    
    mav(LEFTMOTOR1, 0);
    mav(LEFTMOTOR2, 0);
    mav(RIGHTMOTOR1, 0);
    mav(RIGHTMOTOR2, 0);
    msleep(20);
}

void pidMove(float distance, float topSpeed, float finalError){
    cmpc(LEFTMOTOR1);
    cmpc(LEFTMOTOR2);
    cmpc(RIGHTMOTOR1);
    cmpc(RIGHTMOTOR2);
    
    float KP = 5.0;
    float KI = 0.01;
    float KD = 0.1;
    
    float error = distance;
    float lastError = distance;
    float integral = 0;
    float dt = 20;
    
    while(fabsf(error) > finalError){
        // Get position from all motors
        float position = (gmpc(LEFTMOTOR1) - gmpc(LEFTMOTOR2) + gmpc(RIGHTMOTOR1) - gmpc(RIGHTMOTOR2)) / 4.0;
        position /= 37.5;  // Convert to cm
        
        error = distance - position;
        
        printf("Position: %f cm, Error: %f\n", position, error);
        
        integral += (error * dt);
        if((integral > 0 && error < 0) || (integral < 0 && error > 0)){
            integral = 0;  // Anti-windup
        }
        
        float derivative = (error - lastError) / dt;
        float output = (KP * error) + (KI * integral) - (KD * derivative);
        
        // Clamp output to top speed
        if(fabsf(output) > topSpeed){
            output = (output > 0 ? topSpeed : -topSpeed);
        }
        
        mav(LEFTMOTOR1, output);
        mav(LEFTMOTOR2, -output);
        mav(RIGHTMOTOR1, output);
        mav(RIGHTMOTOR2, -output);
        
        lastError = error;
        msleep(dt);
    }
    
    mav(LEFTMOTOR1, 0);
    mav(LEFTMOTOR2, 0);
    mav(RIGHTMOTOR1, 0);
    mav(RIGHTMOTOR2, 0);
}

int main(){
    enable_servos();
    set_servo_position(0, 780);    // Up
    set_servo_position(2, 2300);
    set_servo_position(3, 2300);
    
    // Use the corrected linefollow with proper sensor port
    linefollow(178000, -1500, LIGHTSENSOR1, 0.2);
    
    disable_servos();
    return 0;
}